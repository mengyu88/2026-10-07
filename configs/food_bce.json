{
  "name": "food_bce",
  "source_script": "scripts/train/historical/run_food_spsr_bce_ablation_one.sh",
  "model_name": "bert-base-chinese",
  "data_dir": "preprocess/outputs/food",
  "run_dir": "outputs/food_bce",
  "train_args": {
    "-n": 10,
    "-d": "food",
    "--lr": 1e-06,
    "--encoder_lr": 1e-06,
    "--warmup": 0.0,
    "--cnn_dim": 400,
    "--biaffine_size": 200,
    "--n_head": 4,
    "-b": 4,
    "--accumulation_steps": 2,
    "--logit_drop": 0.15,
    "--cnn_depth": 1,
    "--n_layer": 2,
    "--ent_thres": 0.48,
    "--seed": 0,
    "--loss_type": "bce",
    "--adv_epsilon": 1.0,
    "--adv_alpha": 0.3,
    "--adv_k": 3,
    "--adv_emb_name": "word_embeddings",
    "--adv_loss_weight": 0.8,
    "--adv_warmup_ratio": 0.0,
    "--adv_every_n_steps": 1,
    "--adv_random_start": true,
    "--sad_topk": 2,
    "--sad_use_rel_bias": 1,
    "--sad_gate": 1,
    "--fp16": true,
    "--fp16_init_scale": 1.0,
    "--num_workers": 4,
    "--checkpoint_monitor": "f#f#dev",
    "--early_stop_patience": 0,
    "--separateness_rate": 5,
    "--theta": 1,
    "--loss_theta": 1,
    "--sad_attn_dim": null,
    "--evaluate_every": -1,
    "--num_train_batch_per_epoch": -1,
    "--early_stop_monitor": "f#f#dev",
    "--stop_at_test_f1": 96.34,
    "--use_snsa": 1,
    "--use_hsr": 1,
    "--adv_type": "pgd"
  },
  "model_constants": {
    "size_embed_dim": 25,
    "kernel_size": 3,
    "non_ptm_lr_ratio": 100,
    "weight_decay": 0.0001,
    "schedule": "linear",
    "subword_pooling": "max",
    "num_ner_tag": "Derived from the training data label mapping."
  },
  "notes": [
    "Arguments copied from the named source script; backbone IDs replace server cache paths.",
    "Food profile points to the legacy food split. Supply --data-dir for a different split.",
    "--separateness_rate is a percentage in train.py: 5 becomes 0.05 in CNNNer.",
    "Food retains the historical test-F1 ceiling of 96.34; pass -- --stop_at_test_f1 0 to disable it."
  ]
}
